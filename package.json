{
  "name": "rune-engine-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.11 <25",
    "pnpm": "12.14.0"
  },
  "scripts": {
    "dev": "pnpm --filter @miwang/client dev",
    "online": "pnpm run \"/^online:/\"",
    "online:server": "pnpm --filter @miwang/server dev",
    "online:client": "pnpm --filter @miwang/client dev --mode online",
    "typecheck": "pnpm --filter @miwang/content build:map && pnpm -r --parallel typecheck",
    "test": "vitest run --configLoader native",
    "lint": "oxlint . --deny-warnings",
    "format": "prettier --write . --cache --cache-strategy content",
    "format:check": "prettier --check . --cache --cache-strategy content",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm check:boundaries && pnpm typecheck && pnpm test",
    "smoke": "node scripts/browser/smoke.mjs",
    "smoke:online": "node scripts/browser/online.mjs"
  },
  "devDependencies": {
    "@prettier/plugin-oxc": "catalog:",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
