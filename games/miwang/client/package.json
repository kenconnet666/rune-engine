{
  "name": "@miwang/client",
  "version": "0.0.0",
  "private": true,
  "description": "《迷惘》的浏览器客户端：主线程是界面，模拟（主机）和渲染各在一个 Worker 里",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "predev": "pnpm --filter @miwang/content build:map",
    "dev": "vite --configLoader native",
    "prebuild": "pnpm --filter @miwang/content build:map",
    "build": "vite build --configLoader native",
    "typecheck": "tsc -p . --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo && tsc -p tsconfig.worker.json --incremental --tsBuildInfoFile node_modules/.cache/typecheck-worker.tsbuildinfo"
  },
  "dependencies": {
    "@internationalized/date": "catalog:",
    "@miwang/content": "workspace:^",
    "@miwang/sim": "workspace:^",
    "@rune-engine/core": "workspace:^",
    "@rune-engine/net": "workspace:^",
    "@rune-engine/render": "workspace:^",
    "@rune-engine/runtime": "workspace:^",
    "@rune-engine/ui": "workspace:^",
    "@zerodep-dev/vue-tsx-pro-tsx": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@webgpu/types": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
